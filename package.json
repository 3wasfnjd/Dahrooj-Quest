{
  "name": "dahrooj-quest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run && node scripts/test-reference-summit.mjs",
    "test:xr": "playwright test",
    "build": "node scripts/prepare-assets.mjs && vite build && node scripts/finalize-build.mjs",
    "check:size": "node scripts/check-build.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run check:size",
    "test:production": "node scripts/test-production.mjs"
  },
  "dependencies": {
    "@iwsdk/core": "1.0.1",
    "three": "npm:super-three@0.181.0"
  },
  "devDependencies": {
    "@iwsdk/vite-plugin-dev": "1.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "^22.0.0",
    "@types/three": "0.181.0",
    "@types/webxr": "^0.5.0",
    "@webxr-input-profiles/assets": "^1.0.0",
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "typescript-eslint": "8.71.1",
    "typescript": "6.0.3",
    "vite": "7.3.7",
    "vitest": "5.0.3"
  }
}
